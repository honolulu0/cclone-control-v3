{
  "name": "cclone-control-v3",
  "private": true,
  "version": "0.1.0",
  "description": "Production-grade control surface for Codex runtime",
  "scripts": {
    "dev:backend": "tsx watch backend/src/server.ts",
    "dev:frontend": "vite --config frontend/vite.config.ts",
    "build:backend": "tsc -p backend/tsconfig.json",
    "build:frontend": "vite build --config frontend/vite.config.ts",
    "build": "npm run build:backend && npm run build:frontend",
    "start": "node backend/dist/server.js",
    "check": "tsc -p backend/tsconfig.json --noEmit && tsc -p frontend/tsconfig.json --noEmit",
    "migrate:v2": "tsx backend/src/scripts/import-v2.ts",
    "test:smoke": "tsx tests/smoke.ts",
    "test:contract": "tsx tests/contract.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/static": "^8.2.0",
    "@tanstack/react-query": "^5.90.5",
    "fastify": "^5.6.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.10"
  }
}
